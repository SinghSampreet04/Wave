# Copy this file to .env before starting the production Compose stack.
POSTGRES_DB=wave
POSTGRES_USER=wave
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-base64-encoded-64-byte-secret

# Public browser origin, with no trailing slash.
PUBLIC_ORIGIN=https://wave.example.com
DOMAIN=wave.example.com
ACME_EMAIL=admin@example.com

# Optional email provider settings.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HEALTH_ENABLED=false

# Optional JVM sizing override.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
