# Wave production environment
POSTGRES_DB=wave
POSTGRES_USER=wave
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Base64-encoded 64-byte signing secret
JWT_SECRET=replace-with-a-base64-encoded-64-byte-secret

# Public origin
PUBLIC_ORIGIN=https://wave.example.com
DOMAIN=wave.example.com
ACME_EMAIL=admin@example.com

# SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HEALTH_ENABLED=false

# JVM
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
